{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later",
  "title": "generator.toml manifest",
  "type": "object",
  "required": ["id", "version", "api_version", "module", "kit", "license"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "api_version": {"type": "integer", "minimum": 1},
    "module": {"type": "string", "pattern": "\\.py$"},
    "kit": {"type": "string", "pattern": "\\.toml$"},
    "license": {"enum": ["CC0-1.0", "commercial-eula"]},
    "description": {"type": "string"}
  }
}
