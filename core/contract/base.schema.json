{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TMHSDigital/Game-Assets-R-Us/core/contract/base.schema.json",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later",
  "title": "Game-Assets-R-Us kit contract (base)",
  "description": "Validates everything in kit.toml except the [profiles.*] override tables, which are validated by profiles/<target>/schema.json after merging with the profile defaults.",
  "type": "object",
  "required": ["schema_version", "kit", "grid", "style", "materials", "uv", "texel_density", "collider", "pieces", "exports", "legal"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kit": {
      "type": "object",
      "required": ["id", "name", "version", "prefix", "generator", "default_seed"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$"},
        "generator": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "default_seed": {"type": "integer", "minimum": 0},
        "description": {"type": "string"}
      }
    },
    "grid": {
      "type": "object",
      "required": ["height_cells", "wall_thickness_cells", "snap_tolerance_cells"],
      "additionalProperties": false,
      "properties": {
        "height_cells": {"type": "number", "exclusiveMinimum": 0},
        "wall_thickness_cells": {"type": "number", "exclusiveMinimum": 0},
        "snap_tolerance_cells": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.01}
      }
    },
    "style": {
      "type": "object",
      "required": ["bevel_width_cells", "bevel_segments", "naming_pattern", "lod_pattern", "collider_pattern", "pivot_rule", "variants"],
      "additionalProperties": false,
      "properties": {
        "bevel_width_cells": {"type": "number", "minimum": 0, "maximum": 0.25},
        "bevel_segments": {"type": "integer", "minimum": 1, "maximum": 8},
        "course_height_cells": {"type": "number", "exclusiveMinimum": 0},
        "block_length_cells": {"type": "number", "exclusiveMinimum": 0},
        "mortar_gap_cells": {"type": "number", "minimum": 0},
        "mortar_depth_cells": {"type": "number", "minimum": 0},
        "naming_pattern": {"type": "string", "pattern": "\\{piece\\}"},
        "lod_pattern": {"type": "string", "pattern": "\\{n\\}"},
        "collider_pattern": {"type": "string", "pattern": "\\{index"},
        "pivot_rule": {"enum": ["base_min_corner", "base_center"]},
        "variants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}
      }
    },
    "materials": {
      "type": "object",
      "required": ["max_slots_per_piece", "palette"],
      "additionalProperties": false,
      "properties": {
        "max_slots_per_piece": {"type": "integer", "minimum": 1},
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["slot", "kind", "base_color", "roughness"],
            "additionalProperties": false,
            "properties": {
              "slot": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "kind": {"const": "procedural"},
              "base_color": {"$ref": "#/$defs/rgb"},
              "base_color_2": {"$ref": "#/$defs/rgb"},
              "roughness": {"type": "number", "minimum": 0, "maximum": 1},
              "noise_scale": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "uv": {
      "type": "object",
      "required": ["tiling_channel", "lightmap_channel", "tiling_scale_per_cell"],
      "additionalProperties": false,
      "properties": {
        "tiling_channel": {"type": "string", "minLength": 1},
        "lightmap_channel": {"type": "string", "minLength": 1},
        "tiling_scale_per_cell": {"type": "number", "exclusiveMinimum": 0},
        "lightmap_margin": {"type": "number", "minimum": 0, "maximum": 0.1}
      }
    },
    "texel_density": {
      "type": "object",
      "required": ["texture_size", "min_px_per_cell", "max_px_per_cell", "coverage"],
      "additionalProperties": false,
      "properties": {
        "texture_size": {"type": "integer", "minimum": 16},
        "min_px_per_cell": {"type": "number", "exclusiveMinimum": 0},
        "max_px_per_cell": {"type": "number", "exclusiveMinimum": 0},
        "coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "textures": {
      "type": "object",
      "$comment": "Baked tiling textures per palette slot (core/bake.py).",
      "required": ["bake", "size", "maps"],
      "additionalProperties": false,
      "properties": {
        "bake": {"type": "boolean"},
        "size": {"type": "integer", "minimum": 16, "maximum": 8192},
        "maps": {"type": "array", "minItems": 1, "uniqueItems": true,
                 "items": {"enum": ["base_color", "roughness", "normal"]}}
      }
    },
    "collider": {
      "type": "object",
      "required": ["type", "max_faces_per_part", "max_parts"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["convex", "box", "none"]},
        "max_faces_per_part": {"type": "integer", "minimum": 4},
        "max_parts": {"type": "integer", "minimum": 1}
      }
    },
    "pieces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "footprint_cells", "height_cells", "lod_tris"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
          "footprint_cells": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
          "height_cells": {"type": "number", "exclusiveMinimum": 0},
          "lod_tris": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "integer", "minimum": 1}},
          "seams": {"type": "array", "uniqueItems": true, "items": {"enum": ["x0", "x1", "y0", "y1"]}},
          "seam_profile": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "print_base_cells": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "exports": {
      "type": "object",
      "required": ["profiles"],
      "additionalProperties": false,
      "properties": {
        "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}
      }
    },
    "legal": {
      "type": "object",
      "required": ["license", "texture_provenance", "brand_check", "ai_content"],
      "additionalProperties": false,
      "properties": {
        "license": {"enum": ["CC0-1.0", "commercial-eula"]},
        "license_file": {"type": "string"},
        "eula_file": {"type": "string"},
        "texture_provenance": {"anyOf": [{"const": "generator"}, {"type": "string", "pattern": "^https://"}]},
        "brand_check": {"const": true},
        "ai_content": {"type": "boolean"}
      }
    },
    "print": {
      "type": "object",
      "required": ["manifold", "min_wall_mm", "max_overhang_deg", "base_height_mm", "max_bbox_mm", "print_orientation", "presupport_required", "clip_system"],
      "additionalProperties": false,
      "properties": {
        "manifold": {"const": true},
        "min_wall_mm": {"type": "number", "exclusiveMinimum": 0},
        "max_overhang_deg": {"type": "number", "minimum": 0, "maximum": 90},
        "max_overhang_area_mm2": {"type": "number", "minimum": 0},
        "max_bridge_mm": {"type": "number", "minimum": 0},
        "base_height_mm": {"type": "number", "minimum": 0},
        "max_bbox_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "print_orientation": {"enum": ["base_down", "as_modeled"]},
        "presupport_required": {"type": "boolean"},
        "layer_height_mm": {"type": "number", "exclusiveMinimum": 0},
        "clip_system": {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"enum": ["none", "garu_dogbone_v1"]}},
          "if": {"properties": {"type": {"const": "garu_dogbone_v1"}}},
          "then": {
            "required": ["tolerance_mm", "neck_width_mm", "neck_length_mm", "head_width_mm", "head_length_mm", "height_mm", "roof_mm", "positions"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "garu_dogbone_v1"},
              "tolerance_mm": {"type": "number", "minimum": 0.05, "maximum": 1.0},
              "neck_width_mm": {"type": "number", "exclusiveMinimum": 0},
              "neck_length_mm": {"type": "number", "exclusiveMinimum": 0},
              "head_width_mm": {"type": "number", "exclusiveMinimum": 0},
              "head_length_mm": {"type": "number", "exclusiveMinimum": 0},
              "height_mm": {"type": "number", "exclusiveMinimum": 0},
              "roof_mm": {"type": "number", "exclusiveMinimum": 0},
              "positions": {"enum": ["edge_midpoints"]}
            }
          },
          "else": {"additionalProperties": false, "properties": {"type": {"const": "none"}}}
        }
      }
    },
    "profiles": {
      "type": "object",
      "$comment": "Per-kit overrides; each table is validated by profiles/<name>/schema.json after merging.",
      "additionalProperties": {"type": "object"}
    }
  },
  "$defs": {
    "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}}
  }
}
