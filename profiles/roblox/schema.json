{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later",
  "title": "Profile overlay: roblox",
  "type": "object",
  "required": ["name", "kind", "status", "enabled_in_ci", "experimental", "cell_size", "units", "format", "lod_mode", "lod0_suffix", "collider_mode", "collider_pattern", "material_mode", "piece_texture_size", "export", "limits"],
  "additionalProperties": false,
  "properties": {
    "name": {"const": "roblox"},
    "kind": {"const": "mesh"},
    "status": {"enum": ["working", "stub", "experimental"]},
    "enabled_in_ci": {"type": "boolean"},
    "experimental": {"type": "boolean"},
    "cell_size": {"type": "number", "exclusiveMinimum": 0},
    "units": {"const": "studs"},
    "format": {"const": "fbx"},
    "lod_mode": {"const": "omit"},
    "lod0_suffix": {"type": "string"},
    "collider_mode": {"const": "omit"},
    "collider_pattern": {"type": "string", "pattern": "\\{name\\}.*\\{index"},
    "material_mode": {"const": "single_baked"},
    "piece_texture_size": {"type": "integer", "minimum": 16, "maximum": 8192},
    "export": {
      "type": "object",
      "required": ["scene_unit_system", "axis_forward", "axis_up", "global_scale", "apply_unit_scale", "apply_scale_options", "bake_space_transform", "mesh_smooth_type", "path_mode", "embed_textures"],
      "additionalProperties": false,
      "properties": {
        "scene_unit_system": {"enum": ["NONE", "METRIC"]},
        "axis_forward": {"enum": ["X", "Y", "Z", "-X", "-Y", "-Z"]},
        "axis_up": {"enum": ["X", "Y", "Z", "-X", "-Y", "-Z"]},
        "global_scale": {"type": "number", "exclusiveMinimum": 0},
        "apply_unit_scale": {"type": "boolean"},
        "apply_scale_options": {"enum": ["FBX_SCALE_NONE", "FBX_SCALE_UNITS", "FBX_SCALE_CUSTOM", "FBX_SCALE_ALL"]},
        "bake_space_transform": {"type": "boolean"},
        "mesh_smooth_type": {"enum": ["OFF", "FACE", "EDGE"]},
        "path_mode": {"enum": ["AUTO", "ABSOLUTE", "RELATIVE", "MATCH", "STRIP", "COPY"]},
        "embed_textures": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source", "verified"],
        "additionalProperties": false,
        "properties": {
          "value": {"type": "number", "exclusiveMinimum": 0},
          "source": {"type": "string", "pattern": "^https://create\\.roblox\\.com/"},
          "verified": {"type": "boolean"}
        },
        "if": {"properties": {"verified": {"const": true}}},
        "then": {"required": ["value"]},
        "else": {"not": {"required": ["value"]}}
      }
    }
  }
}
