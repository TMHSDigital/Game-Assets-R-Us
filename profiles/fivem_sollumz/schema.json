{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later",
  "title": "Profile overlay: fivem_sollumz",
  "type": "object",
  "required": ["name", "kind", "status", "enabled_in_ci", "experimental", "cell_size", "units", "format", "exporter", "lod_mode", "lod0_suffix", "collider_mode", "collider_pattern", "blender_version", "sollumz_repo", "sollumz_commit", "sollumz_addon", "szio_version", "szio_sha256", "shader", "collision_material", "archetype_prefix", "embedded_collision", "lod_distances", "streamed_memory_warn_mib", "target_builds"],
  "additionalProperties": false,
  "properties": {
    "name": {"const": "fivem_sollumz"},
    "kind": {"const": "mesh"},
    "status": {"enum": ["working", "stub", "experimental"]},
    "enabled_in_ci": {"type": "boolean"},
    "experimental": {"type": "boolean"},
    "cell_size": {"type": "number", "exclusiveMinimum": 0},
    "units": {"const": "m"},
    "format": {"const": "ydr_xml"},
    "exporter": {"const": "sollumz"},
    "lod_mode": {"const": "embedded"},
    "lod0_suffix": {"type": "string"},
    "collider_mode": {"const": "embedded"},
    "collider_pattern": {"type": "string", "pattern": "\\{name\\}.*\\{index"},
    "blender_version": {"const": "4.5"},
    "sollumz_repo": {"const": "https://github.com/Sollumz/Sollumz"},
    "sollumz_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sollumz_addon": {"type": "string", "pattern": "^bl_ext\\.[a-z_]+\\.[a-z0-9_]+$"},
    "szio_version": {"type": "string", "minLength": 1},
    "szio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shader": {"type": "string", "pattern": "\\.sps$"},
    "collision_material": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "archetype_prefix": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "embedded_collision": {"type": "boolean"},
    "lod_distances": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "number", "exclusiveMinimum": 0}},
    "streamed_memory_warn_mib": {"type": "number", "exclusiveMinimum": 0},
    "target_builds": {"type": "array", "items": {"type": "integer", "minimum": 1}}
  }
}
